# Template des variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# Ne jamais commiter .env.local

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# DSN Sentry (monitoring d'erreurs). Préfixe NEXT_PUBLIC_ requis : le DSN
# doit être inliné dans le bundle client. Ce n'est pas un secret.
NEXT_PUBLIC_SENTRY_DSN=

# Token d'accès personnel Supabase — requis par le CLI (`npx supabase ...`)
# et par scripts/query-supabase.mjs (API de management).
# À générer sur https://supabase.com/dashboard/account/tokens
# ⚠ Vrai secret (accès à tous les projets du compte) — uniquement dans .env.local
SUPABASE_ACCESS_TOKEN=

# Token d'intégration Notion — utilisé par scripts/pull-aide.mjs (#97) pour
# tirer la doc utilisateur (/aide) depuis la base « Guide OMQ ». Créer une
# intégration interne sur https://www.notion.so/my-integrations (capacité
# « Lire le contenu »), puis PARTAGER la page « Guide utilisateur — On mange
# quoi ? » avec elle (••• → Connexions → ton intégration).
# - En local : ici (.env.local), le script le charge tout seul → `npm run pull:aide`.
# - Pour l'AUTONOMIE des déploiements : mettre aussi NOTION_TOKEN dans les
#   variables d'env VERCEL → le hook `prebuild` régénère l'aide à chaque build.
# Sans token, le build retombe sur le contenu committé (pas d'échec).
# ⚠ Vrai secret — uniquement dans .env.local, jamais commité.
NOTION_TOKEN=

# Rate-limiting des routes API (#191, audit F-04) — Upstash Redis (REST).
# Créer une base sur https://upstash.com (ou via l'intégration Vercel Marketplace)
# puis renseigner ces deux variables dans les variables d'env VERCEL (prod).
# ⚠ Si ABSENTES, le limiteur est NO-OP (aucune limite) — c'est volontaire en CI
# (les e2e génèrent plusieurs plannings) et toléré en dev local.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
