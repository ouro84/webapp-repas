{
  "enabledPlugins": {
    "svg-vectorizer@svg-new-tools": true,
    "understand-anything@understand-anything": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Arnaud/AppData/Roaming/Python/Python314/Scripts/graphify.EXE hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/Arnaud/AppData/Roaming/Python/Python314/Scripts/graphify.EXE hook-guard read"
          }
        ]
      }
    ]
  }
}