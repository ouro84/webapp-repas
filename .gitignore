# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — les fichiers avec de vraies valeurs ne sont jamais commités
.env
.env.local
.env*.local
# .env.example est volontairement commité (template sans valeurs)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
/e2e/.auth/
/test-results/
/playwright-report/

# outils de dev locaux (non partagés) — sauf les règles agent et les réglages
# partagés de Claude Code, versionnés (critère de merge, cf. CLAUDE.md)
.claude/*
!.claude/rules/
!.claude/settings.json
revueDesign/
# NB : .understand-anything/ n'est volontairement PAS ignoré — le knowledge
# graph a vocation à être commité prochainement (à versionner sciemment).

.vercel
.env*

# graphify — graphe de connaissances généré localement
/graphify-out/

# Spike Chronodrive (#307) : dépendances installées sur le NAS
integrations/**/node_modules
